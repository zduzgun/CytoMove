{
  "name": "cytomove-desktop-beta",
  "version": "0.1.0-beta.1",
  "private": true,
  "description": "Cytomove Desktop Beta - local-first wound healing analysis app.",
  "main": "main.js",
  "author": "Cytomove",
  "license": "UNLICENSED",
  "scripts": {
    "start": "electron .",
    "check": "node --check main.js && node --check preload.js && node --check renderer/app.js",
    "pack:win": "powershell -ExecutionPolicy Bypass -File scripts/package-win-unpacked.ps1",
    "pack:win:builder": "electron-builder --win --dir",
    "dist:win": "electron-builder --win",
    "portable:win": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.7.7",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.cytomove.desktop",
    "productName": "Cytomove Desktop Beta",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "portable": {
      "artifactName": "Cytomove-Desktop-Beta-${version}-portable.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Cytomove-Desktop-Beta-${version}-setup.${ext}"
    }
  }
}
